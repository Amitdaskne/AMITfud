<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="12dp" android:background="@color/white"
    android:layout_marginBottom="1dp">

    <ImageView android:id="@+id/ivProduct" android:layout_width="100dp" android:layout_height="100dp"
        android:scaleType="centerCrop" android:background="@color/skeleton_bg"/>

    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="16dp" android:layout_gravity="center_vertical">
        
        <TextView android:id="@+id/tvProductName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Product Name" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_dark"/>
            
        <TextView android:id="@+id/tvProductPrice" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="₹250" android:textSize="14sp" android:textColor="@color/text_gray" android:layout_marginTop="4dp"/>
            
        <TextView android:id="@+id/tvProductDiscount" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="20% OFF" android:textSize="12sp" android:textColor="#388E3C" android:textStyle="bold" android:layout_marginTop="4dp"/>
            
        <Button android:id="@+id/btnAdd" android:layout_width="80dp" android:layout_height="35dp"
            android:text="ADD" android:textSize="12sp" android:background="@drawable/bg_pill_red"
            android:textColor="@color/white" android:layout_marginTop="8dp"/>
    </LinearLayout>
</LinearLayout>
